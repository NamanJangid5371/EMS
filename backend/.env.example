PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/appinop_ems
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
ADMIN_PORTAL_URL=http://127.0.0.1:3000
MANAGER_PORTAL_URL=http://127.0.0.1:3001
API_PUBLIC_URL=http://127.0.0.1:5000

# Gmail SMTP (use a Google App Password — never commit real secrets)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=Appinop EMS <your-gmail@gmail.com>
